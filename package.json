{
  "name": "chess-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Interaktiver Schachtrainer mit Stockfish-Analyse und optionalem OpenAI-Coach.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-stockfish-assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "site:build": "opennextjs-cloudflare build && node scripts/patch-opennext-worker.mjs",
    "site:package": "npm run site:build && node scripts/package-site.mjs",
    "site:preview": "npm run site:build && opennextjs-cloudflare preview",
    "openings:import": "node scripts/import-lichess-openings.mjs",
    "openings:check": "node scripts/check-opening-data.mjs",
    "puzzles:import:800": "node scripts/import-lichess-puzzles.mjs https://database.lichess.org/lichess_db_puzzle.csv.zst --output data/knowledge/lichess-puzzles-800.json --min-rating 600 --max-rating 1100 --max-rating-deviation 100 --min-popularity 60 --themes pawnEndgame,rookEndgame,bishopEndgame,knightEndgame,deflection,capturingDefender,backRankMate,defensiveMove,equality,sacrifice --theme-quota pawnEndgame=1000 --theme-quota rookEndgame=1000 --theme-quota bishopEndgame=600 --theme-quota knightEndgame=600 --theme-quota deflection=750 --theme-quota capturingDefender=750 --theme-quota backRankMate=750 --theme-quota defensiveMove=1000 --theme-quota equality=500 --theme-quota sacrifice=500",
    "pgn:index": "node scripts/build-coach-pgn-index.mjs",
    "pgn:check": "node scripts/check-coach-pgn-index.mjs",
    "pgn:training-export": "node scripts/build-coach-pgn-index.mjs --training-output=data/pgn/coach-pgn-training.json",
    "pgn:analyze": "node scripts/analyze-coach-annotations.mjs",
    "pgn:evaluate": "node scripts/evaluate-concept-transfer.mjs",
    "coach:evaluate": "node scripts/evaluate-coach-corpus.mjs --samples-per-cell=200 --strict",
    "coach:stress": "node scripts/stress-test-coach-games.mjs --games=300 --positions-per-phase=75 --depth=5 --strict",
    "coach:audit:800": "node scripts/audit-coach-800.mjs",
    "coach:benchmark": "node scripts/run-coach-benchmark.mjs --quick",
    "coach:benchmark:v1": "node scripts/run-coach-benchmark.mjs --quick --suite=v1",
    "coach:benchmark:v2": "node scripts/run-coach-benchmark.mjs --quick --suite=v2",
    "coach:benchmark:v2:full": "node scripts/run-coach-benchmark.mjs --full --suite=v2",
    "coach:benchmark:regression": "npm run coach:benchmark:v1 && npm run coach:benchmark:v2",
    "coach:benchmark:full": "node scripts/run-coach-benchmark.mjs --full",
    "coach:benchmark:dataset": "node scripts/build-coach-benchmark-dataset.mjs --pgn=data/benchmarks/pgn-candidates.json",
    "coach:benchmark:v2:dataset": "node scripts/build-coach-benchmark-v2.mjs",
    "coach:benchmark:pgn": "node scripts/generate-pgn-benchmark-candidates.mjs",
    "coach:training:seed": "node scripts/seed-coach-training-candidates.mjs",
    "coach:training:review": "next dev",
    "coach:training:build": "node scripts/build-coach-training-dataset.mjs",
    "coach:training:check": "node scripts/build-coach-training-dataset.mjs --check",
    "coach:review-stress": "COACH_GAME_REVIEW_STRESS_GAMES=60 COACH_GAME_REVIEW_STRESS_PLIES=36 node --test test/gameReviewStress.test.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check": "npm run pgn:check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "chess.js": "^1.0.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "^18.0.8"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^13.0.6"
    },
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "fzstd": "^0.1.1",
    "wrangler": "^4.114.0"
  }
}
