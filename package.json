{
  "name": "chess-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Interaktiver Schachtrainer mit Stockfish-Analyse und optionalem OpenAI-Coach.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/sync-stockfish-assets.mjs",
    "predev": "npm run assets",
    "dev": "next dev",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "site:build": "opennextjs-cloudflare build && node scripts/patch-opennext-worker.mjs",
    "site:package": "npm run site:build && node scripts/package-site.mjs",
    "site:preview": "npm run site:build && opennextjs-cloudflare preview",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "chess.js": "^1.0.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "^18.0.8"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^13.0.6"
    },
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
