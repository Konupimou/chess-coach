# Server-only OpenAI configuration. Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-5.6-luna
SAFETY_ID_SALT=replace-with-a-random-private-value

# Optional stable identifier for Lichess OAuth. Defaults to the current host.
LICHESS_CLIENT_ID=

# Chess.com asks PubAPI clients to identify themselves. Include a real contact.
CHESSCOM_USER_AGENT=Chess-Coach/1.0 (game-sync; contact: you@example.com)
